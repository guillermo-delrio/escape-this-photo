{"actions":[{"effect":{"after":"The pillow lies flattened, its hiding place empty.","gives":["note1"],"message":"Under the blue-patterned pillow is a folded slip. You take it.","image":"/data/50dbd9e6c4/interior-inspect-pillow.jpg"},"id":"inspect-pillow","kind":"inspect","target":"pillow"},{"effect":{"closeup":"antler-mounts","message":"You step up to the horned skulls above the bed frame. You study them against the white plaster.","reveals":["f_antlers"]},"id":"inspect-antlers","kind":"inspect","target":"antler-mounts","when":{"items":["note1"]}},{"effect":{"closeup":"slippers","message":"You step up to the wicker basket under the gray coat. You look hard at the wooden shoes inside.","reveals":["f_slippers"]},"id":"inspect-slippers","kind":"inspect","target":"slippers","when":{"items":["note1"]}},{"code":"32","derivedFrom":["f_antlers","f_slippers"],"effect":{"after":"The dresser drawer hangs open, empty.","gives":["key1"],"message":"The dresser drawer clicks open. Inside glints a little brass key.","image":"/data/50dbd9e6c4/interior-code-dresser.jpg"},"id":"code-dresser","kind":"code","target":"dresser"},{"effect":{"after":"The sideboard doors stand ajar, empty inside.","gives":["key2"],"message":"The small brass shape turns in the sideboard lock. Inside lies a heavy iron key.","takes":["key1"]},"id":"use-key1-sideboard","item":"key1","kind":"use","target":"sideboard","when":{"items":["key1"]}},{"effect":{"after":"The locked wooden door stands open behind you.","message":"The locked wooden door swings on its hinges. You slip out of the bedroom.","sets":["escaped"],"takes":["key2"]},"id":"use-key2-door","item":"key2","kind":"use","target":"wooden-door","when":{"items":["key2"]}}],"facts":[{"id":"f_antlers","kind":"count","objectIds":["antler-mounts"],"value":"3"},{"id":"f_slippers","kind":"count","objectIds":["slippers"],"value":"2"}],"intro":"You are trapped in a white farm bedroom with a low bed and dark wood furniture. You must escape through the locked wooden d